# ---
# Required Environment Variables
# The app will not start if any of these parameters are missing. 
# Set these in a .env file or as environment variables.
# ---

POSTGRES_USER=earnit_user
POSTGRES_PASSWORD=earnit
POSTGRES_DB=earnit_db

# -- JWT/HMAC Signing Key Settings --
# Recommended to generate with: $ openssl rand -hex 32

SECRET_KEY=YOUR_SECRET_KEY_HERE

# ---
# Override App Default Settings (Optional)
# Options below to override default values of the app. Uncomment to use.
# Current values are the defaults. Change as needed.
# ---

# -- Database Settings --
# localhost when running outside Docker; the api container sets host=db.

#POSTGRES_HOST=localhost
#POSTGRES_PORT=5432

# CORS — comma-separated, or a JSON array.
#CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Email (Mailpit dev sink). MAIL_SERVER=localhost when running outside Docker.
#MAIL_SERVER=mailpit
#MAIL_PORT=1025
#MAIL_FROM=noreply@earnit.app
#MAIL_USERNAME=
#MAIL_PASSWORD=

# Password Policy Settings:
#PASSWORD_MIN_LENGTH=12

# Verification Codes & Limbo purge Settings:
#VERIFICATION_CODE_LENGTH=6
#VERIFICATION_CODE_EXPIRY_MINUTES=10
#ACCOUNT_LIMBO_PURGE_HOURS=24

# Session Lifetimes Settings (In Minutes):
#ACCESS_TOKEN_EXPIRE_MINUTES=43200 # 30 days
#PENDING_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440 # 1 day

# Profiles & parental PIN Settings:
#MAX_CHILDREN_PER_USER=10
#AVATAR_UPLOAD_DIR=/app/uploads/avatars
#AVATAR_MAX_BYTES=5242880
#SUBMISSION_PROOF_UPLOAD_DIR=/app/uploads/submission-proofs
#SUBMISSION_PROOF_MAX_BYTES=5242880
#PARENT_PIN_LENGTH=4

# Logging  Settings (DEBUG, INFO, WARNING, ERROR, or CRITICAL):
#LOG_LEVEL=INFO

# Dev Settings:

# Bypasses JWT auth — every request runs as fallback dev user account dev@earnit.local.
# Set explicitly: src/config.py defaults this to `true`, so OMITTING it disables
# auth. Keep it `false` unless you specifically want the no-auth dev mode.
# NEVER, NEVER enable this in production!!!

#DISABLE_AUTH=True
