POSTGRES_USER=earnit_user
POSTGRES_PASSWORD=earnit
POSTGRES_DB=earnit_db
# localhost for running outside Docker (e.g. pytest); the api container
# overrides this to "db" via compose.yaml's environment section.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Generate with: openssl rand -hex 32
SECRET_KEY=

# Set to localhost when running the app outside Docker
MAIL_SERVER=mailpit
MAIL_PORT=1025
MAIL_FROM=noreply@earnit.app
MAIL_USERNAME=
MAIL_PASSWORD=

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# DEBUG, INFO, WARNING, ERROR, or CRITICAL
LOG_LEVEL=INFO
