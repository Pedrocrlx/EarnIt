# Production: copy to .env at the repository root. All runtime settings live here.
# Public HTTPS origin served by the VPS's main Nginx (no trailing slash).
CORS_ORIGINS=https://earnit.example.com

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=earnit
POSTGRES_DB=earnit
# Generate each secret separately with: openssl rand -hex 32
POSTGRES_PASSWORD=
SECRET_KEY=

# Keep authentication enabled in production.
DISABLE_AUTH=False
LOG_LEVEL=INFO

# Brevo: copy the sender, SMTP login and SMTP key already tested locally.
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_FROM=noreply@your-domain.com
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
MAIL_USE_CREDENTIALS=True
MAIL_VALIDATE_CERTS=True

# These paths match the persistent volumes in compose.prod.yaml.
AVATAR_UPLOAD_DIR=/app/uploads/avatars
SUBMISSION_PROOF_UPLOAD_DIR=/app/uploads/submission-proofs
